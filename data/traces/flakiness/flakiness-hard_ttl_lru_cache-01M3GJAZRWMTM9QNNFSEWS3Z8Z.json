{"episode_id": "flakiness-hard_ttl_lru_cache-01M3GJAZRWMTM9QNNFSEWS3Z8Z", "family": "flakiness", "task_id": "hard_ttl_lru_cache", "model": "claude-sonnet-5", "started": 1790483726.1087801, "turns": [{"assistant": [{"signature": "", "thinking": "", "type": "thinking"}, {"id": "toolu_01HiYJkChmD3p256q1SLBwb6", "caller": {"type": "direct"}, "input": {"code": "\ndef cache_sim(capacity, ttl, ops):\n    from collections import OrderedDict\n    cache = OrderedDict()  # key -> (value, write_time)\n    results = []\n    for op in ops:\n        if op[0] == 'put':\n            _, t, key, value = op\n            # remove any expired entries (they count as absent everywhere)\n            expired_keys = [k for k, (v, wt) in cache.items() if wt + ttl <= t]\n            for k in expired_keys:\n                del cache[k]\n            if key in cache:\n                # existing valid entry, remove to reinsert at MRU position\n                del cache[key]\n            elif len(cache) >= capacity:\n                # evict least recently used\n                cache.popitem(last=False)\n            cache[key] = (value, t)\n        else:\n            _, t, key = op\n            if key in cache:\n                value, wt = cache[key]\n                if wt + ttl <= t:\n                    # expired, remove and treat as absent\n                    del cache[key]\n                    results.append(-1)\n                else:\n                    # move to most recently used, keep write time unchanged\n                    del cache[key]\n                    cache[key] = (value, wt)\n                    results.append(value)\n            else:\n                results.append(-1)\n    return results\n"}, "name": "submit", "type": "tool_use", "toolset_name": null}], "usage": {"cache_creation": {"ephemeral_1h_input_tokens": 0, "ephemeral_5m_input_tokens": 0}, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0, "inference_geo": "global", "input_tokens": 744, "output_tokens": 1580