{"episode_id": "flakiness-hard_ttl_lru_cache-01M33RTKBN7C7PJ77XCTEGWNWR", "family": "flakiness", "task_id": "hard_ttl_lru_cache", "model": "claude-sonnet-5", "started": 1790054321.5253031, "turns": [{"assistant": [{"signature": "", "thinking": "", "type": "thinking"}, {"id": "toolu_01DzCNa8LQaPW4J9FMB6t6et", "caller": {"type": "direct"}, "input": {"code": "\nfrom collections import OrderedDict\n\ndef cache_sim(capacity, ttl, ops):\n    cache = OrderedDict()  # key -> [value, write_time]\n    results = []\n\n    for op in ops:\n        if op[0] == 'put':\n            _, t, key, value = op\n\n            # If key exists but expired, remove it first\n            if key in cache:\n                val, wt = cache[key]\n                if wt + ttl <= t:\n                    del cache[key]\n\n            if key in cache:\n                # update existing valid entry\n                cache[key] = [value, t]\n                cache.move_to_end(key)\n            else:\n                # need to insert new entry; clean up expired entries first\n                expired_keys = [k for k, (v, wt) in cache.items() if wt + ttl <= t]\n                for k in expired_keys:\n                    del cache[k]\n\n                if len(cache) >= capacity:\n                    cache.popitem(last=False)\n\n                cache[key] = [value, t]\n                # newly inserted, already at end (most recently used)\n\n        elif op[0] == 'get':\n            _, t, key = op\n\n            if key in cache:\n                val, wt = cache[key]\n                if wt + ttl <= t:\n                    del cache[key]\n                    results.append(-1)\n                else:\n                    results.append(val)\n                    cache.move_to_end(key)\n            else:\n                results.append(-1)\n\n    return results\n"}, "name": "submit", "type": "tool_use", "toolset_name": null}], "usage": {"cache_creation": {"ephemeral_1h_input_tokens": 0, "ephemeral_5m_input_tokens": 0}